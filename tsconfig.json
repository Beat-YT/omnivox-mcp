{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": false,
        "outDir": "./dist",
        "paths": {
            "src/*": ["./src/*"],
            "@api/*": ["./src/omnivox-api/requests/*"],
            "@schemas/*": ["./src/mcp/schemas/*"],
            "@transformers/*": ["./src/mcp/transformers/*"],
            "@typings/*": ["./src/omnivox-api/typings/*"],
            "@common/*": ["./src/common/*"]
        }
    }
}
